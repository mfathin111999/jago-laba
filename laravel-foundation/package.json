        "@vitejs/plugin-vue": "^6.0.10",
        "laravel-vite-plugin": "^3.1",
        "playwright": "^1.64.1",
        "typescript": "^5.9.0",
        "vite": "^8.0.0",
        "vue": "^3.5.0",
        "vue-tsc": "^3.1.0"
    }
