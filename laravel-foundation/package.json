{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "css:tailwind": "npx --yes tailwindcss@3.4.17 -c tailwind.legacy.config.cjs -i resources/css/legacy/tailwind-input.css -o resources/css/legacy/tailwind.generated.css --minify",
        "dev": "vite",
